{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "humanly",
  "main": "./src/index.ts",
  "compatibility_date": "2026-04-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/config.json", "/healthz"]
  }
}
