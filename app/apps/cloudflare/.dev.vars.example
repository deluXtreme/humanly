# x402 is enabled by default for /api/auctions/*
# For local dev, either set a real pay-to address:
# X402_PAY_TO=0x0000000000000000000000000000000000000001
# X402_NETWORK=eip155:84532
# X402_AUCTION_INFO_PRICE=$0.001
# X402_AUCTION_ACTION_PRICE=$0.01
# X402_FACILITATOR_URL=https://x402.org/facilitator
# or explicitly disable the gate:
# X402_DISABLED=true
