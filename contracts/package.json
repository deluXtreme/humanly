{
  "name": "@prb/foundry-template",
  "description": "Foundry-based template for developing Solidity smart contracts",
  "private": true,
  "version": "1.0.0",
  "author": {
    "name": "Paul Razvan Berg",
    "url": "https://github.com/PaulRBerg"
  },
  "dependencies": {
    "@openzeppelin/contracts": "github:OpenZeppelin/openzeppelin-contracts#8e0296096449d9b1cd7c5631e917330635244c37",
    "@circlefin/evm-cctp-contracts": "github:circlefin/evm-cctp-contracts#4061786a5726bc05f99fcdb53b0985599f0dbaf7",
    "@memview-sol/contracts": "github:summa-tx/memview-sol#79a08cb25aac047d81c67c5422c9b55abfac8635"
  },
  "devDependencies": {
    "forge-std": "github:foundry-rs/forge-std#v1.9.7",
    "prettier": "^3.5",
    "solhint": "^5.1"
  },
  "keywords": [
    "blockchain",
    "ethereum",
    "forge",
    "foundry",
    "smart-contracts",
    "solidity",
    "template"
  ],
  "scripts": {
    "clean": "rm -rf cache out",
    "build": "forge build",
    "forge-check": "forge fmt --check",
    "forge-write": "forge fmt",
    "lint": "bun run lint:sol && bun run prettier:check",
    "lint:sol": "bun run forge-check && bun solhint \"{script,src,tests}/**/*.sol\"",
    "prettier:check": "prettier --check \"**/*.{json,md,yml}\"",
    "prettier:write": "prettier --write \"**/*.{json,md,yml}\"",
    "test": "forge test"
  }
}
